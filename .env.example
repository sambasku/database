# Sumber export. Jangan commit .env.
#
# CI pakai org secrets (prioritas):
#   DB_STAGING_TURSO_URL / DB_STAGING_TURSO_AUTH_TOKEN
#   DB_PRODUCTION_TURSO_URL / DB_PRODUCTION_TURSO_AUTH_TOKEN
# Acuan: docs/github/org-db-secrets.md
#
# Staging sqld (contoh):
# DATABASE_URL=https://db-sambasku-staging.iamutaki.com
# DATABASE_AUTH_TOKEN=...
#
# Dev lokal (path relatif dari root repo database/):
DATABASE_URL=file:../api/local.db
DATABASE_AUTH_TOKEN=

# Opsional
# DATASET_RELEASE_VERSION=1
# DATASET_CHANNEL=staging
# DATASET_OUT_DIR=./tmp/dataset-export
# DATASET_MIN_APP_VERSION=0.1.0
